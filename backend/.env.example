# ─────────────────────────────────────────────────────────────────────────────
# ThinkBack backend — example environment variables
# Copy this file to .env and fill in real values.
# NEVER commit your real .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────────────────────────
# Neon PostgreSQL connection string (or any PostgreSQL-compatible URL).
DATABASE_URL=postgresql+psycopg://user:password@host/dbname

# ── Qdrant vector store ───────────────────────────────────────────────────────
QDRANT_URL=https://your-cluster.qdrant.io
QDRANT_API_KEY=your-qdrant-api-key

# ── JWT authentication ────────────────────────────────────────────────────────
# A long, random secret used to sign JWT access tokens.
# Generate a suitable value with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# Keep this value private — anyone with it can forge tokens.
JWT_SECRET_KEY=replace-this-with-a-random-hex-string-of-at-least-32-chars

# How long (in minutes) a JWT access token remains valid.
# 60 = one hour.  Adjust based on your security/UX requirements.
ACCESS_TOKEN_EXPIRE_MINUTES=60
